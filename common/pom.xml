<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.bloomreach.forge.facetedsegmentation</groupId>
    <artifactId>bloomreach-facetedsegmentation</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <name>Bloomreach Forge Faceted Segmentation Plugin Common</name>
  <description>
    The expression grammar: parser, evaluator and canonical formatter. Deliberately free of any
    brXM, JCR or HST dependency — it imports nothing but the JDK — so the grammar can be reused by
    tooling, a migration script, or a test harness without dragging in the platform.
  </description>
  <artifactId>bloomreach-facetedsegmentation-common</artifactId>
  <packaging>jar</packaging>

  <dependencies>
    <!-- TEST ONLY. This module has no compile dependencies at all, by design. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-params</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      RealCatalogIntegrationTest reads the generated catalog fixture as JSON. Jackson is test-scope
      here precisely because the grammar layer itself must stay dependency-free.
    -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson2.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-site-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
