<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    hippo-cms7-project (NOT -release) is the parent for plugin LIBRARIES. It supplies
    ${hippo.release.version}, ${junit-jupiter.version}, the maven-compiler-plugin <release>21
    setting and the surefire configuration. The demo, being a webapp project, uses
    hippo-cms7-release instead — see demo/pom.xml.
  -->
  <parent>
    <groupId>org.onehippo.cms7</groupId>
    <artifactId>hippo-cms7-project</artifactId>
    <version>17.2.0</version>
  </parent>

  <name>Bloomreach Forge Faceted Segmentation Plugin</name>
  <description>
    A brXM Open UI document field that replaces a wall of multi-select facet palettes with a single
    readable boolean expression, plus the delivery-tier parser and evaluator that enforce it.
  </description>
  <groupId>org.bloomreach.forge.facetedsegmentation</groupId>
  <artifactId>bloomreach-facetedsegmentation</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <inceptionYear>2026</inceptionYear>

  <properties>
  </properties>

  <scm>
    <connection>scm:git:git@github.com:bloomreach-forge/faceted-segmentation.git</connection>
    <developerConnection>scm:git:git@github.com:bloomreach-forge/faceted-segmentation.git</developerConnection>
    <url>https://github.com/bloomreach-forge/faceted-segmentation.git</url>
    <tag>HEAD</tag>
  </scm>

  <distributionManagement>
    <repository>
      <name>Bloomreach Maven 2 Forge Repository</name>
      <id>bloomreach-maven2-forge</id>
      <url>https://maven.bloomreach.com/content/repositories/forge-releases/</url>
      <uniqueVersion>false</uniqueVersion>
    </repository>
  </distributionManagement>

  <issueManagement>
    <url>https://bloomreach.atlassian.net/jira/software/c/projects/FORGE/issues</url>
  </issueManagement>

  <repositories>
    <repository>
      <id>bloomreach-maven2</id>
      <name>Bloomreach Maven 2 Repository</name>
      <url>https://maven.bloomreach.com/repository/maven2/</url>
    </repository>
    <repository>
      <id>bloomreach-maven2-forge</id>
      <name>Bloomreach Forge Maven 2 repository.</name>
      <url>https://maven.bloomreach.com/repository/maven2-forge/</url>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
      <releases>
        <updatePolicy>never</updatePolicy>
      </releases>
      <layout>default</layout>
    </repository>
  </repositories>

  <licenses>
    <license>
      <name>The Apache Software License, Version 2.0</name>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <!--
    The demo is deliberately NOT a module here. It is an independent Maven project (its own parent
    and reactor) that consumes the published artifacts exactly as a customer project would — which
    is what makes it a real test of the plugin rather than of the build. Build it with:
      mvn clean install          (this pom, first — the demo resolves these from the local repo)
      cd demo && mvn clean verify
  -->
  <modules>
    <module>common</module>
    <module>hst</module>
    <module>repository</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <!--
        All brXM dependencies are `provided`: the platform supplies them at runtime, and a plugin
        must never bundle its own copy. Child modules declare groupId+artifactId only.
      -->
      <dependency>
        <groupId>org.onehippo.cms7.hst</groupId>
        <artifactId>hst-api</artifactId>
        <version>${hippo.release.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>org.onehippo.cms7.hst.components</groupId>
        <artifactId>hst-core</artifactId>
        <version>${hippo.release.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>org.onehippo.cms7.hst</groupId>
        <artifactId>hst-commons</artifactId>
        <version>${hippo.release.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>org.onehippo.cms7.hst.components</groupId>
        <artifactId>hst-jaxrs</artifactId>
        <version>${hippo.release.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>org.onehippo.cms7.hst</groupId>
        <artifactId>hst-content-beans</artifactId>
        <version>${hippo.release.version}</version>
        <scope>provided</scope>
      </dependency>
      <!-- BaseHstComponent, the base class for an HST component. -->
      <dependency>
        <groupId>org.onehippo.cms7.hst</groupId>
        <artifactId>hst-client</artifactId>
        <version>${hippo.release.version}</version>
        <scope>provided</scope>
      </dependency>
      <!-- @Parameter / @JcrPath / @DropDownList — the Channel Manager parameter annotations. -->
      <dependency>
        <groupId>org.onehippo.cms7</groupId>
        <artifactId>hippo-cms7-commons</artifactId>
        <version>${hippo.release.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>org.onehippo.cms7</groupId>
        <artifactId>hippo-repository-api</artifactId>
        <version>${hippo.release.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>org.onehippo.cms7</groupId>
        <artifactId>hippo-services</artifactId>
        <version>${hippo.release.version}</version>
        <scope>provided</scope>
      </dependency>
      <!-- The value-list content beans (selection:valuelist / selection:listitem). -->
      <dependency>
        <groupId>org.onehippo.cms7</groupId>
        <artifactId>hippo-plugin-selections-hst-client</artifactId>
        <version>${hippo.release.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j2.version}</version>
        <scope>provided</scope>
      </dependency>

      <!-- TEST -->
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter-api</artifactId>
        <version>${junit-jupiter.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter-engine</artifactId>
        <version>${junit-jupiter.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter-params</artifactId>
        <version>${junit-jupiter.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <defaultGoal>package</defaultGoal>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-site-plugin</artifactId>
        <version>${maven.plugin.site.version}</version>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!--
        Publishes the Maven site into this repository's own docs/ folder, which GitHub Pages
        serves from the master branch (the Bloomreach Forge convention). Requires src/site/ to
        exist; see the root README's Status section.

          mvn clean install
          find docs -name "*.html" -exec rm {} \;
          mvn -Pgithub.pages clean site
      -->
      <id>github.pages</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-site-plugin</artifactId>
            <inherited>false</inherited>
            <configuration>
              <outputDirectory>docs</outputDirectory>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
