<'facetseg'='http://www.bloomreach.org/forge/facetedsegmentation/nt/1.0'>
<'hippo'='http://www.onehippo.org/jcr/hippo/nt/2.0.4'>
<'hippostd'='http://www.onehippo.org/jcr/hippostd/nt/2.0'>
<'hippostdpubwf'='http://www.onehippo.org/jcr/hippostdpubwf/nt/1.0'>
<'hippotranslation'='http://www.onehippo.org/jcr/hippotranslation/nt/1.0'>

[facetseg:FacetedSegmentationSection] > hippo:compound, hippostd:relaxed

[facetseg:basedocument] > hippo:document, hippostd:publishableSummary, hippostdpubwf:document
  orderable

[facetseg:PersonalizedContent] > facetseg:basedocument, hippostd:relaxed, hippotranslation:translated
  orderable
