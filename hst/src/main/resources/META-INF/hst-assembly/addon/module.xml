<!--
  HST scans every classpath entry for META-INF/hst-assembly/addon/module.xml, so simply putting this
  jar on the site webapp's classpath registers the plugin's beans. No per-project wiring is needed.

  The bean files are namespaced by Java package so two addon jars cannot collide. The `overrides`
  location is the extension point: a consuming project drops an XML file at the same path under
  META-INF/hst-assembly/overrides/addon/... to redefine any bean by id — which is how a project
  points the reader at its own value-list folder.
  -->
<module xmlns="http://www.onehippo.org/schema/hst/hst-addon-module_1_0.xsd">
  <name>org.bloomreach.forge.facetedsegmentation.hst</name>
  <config-locations>
    <config-location>classpath*:META-INF/hst-assembly/addon/org/bloomreach/forge/facetedsegmentation/*.xml</config-location>
    <config-location>classpath*:META-INF/hst-assembly/overrides/addon/org/bloomreach/forge/facetedsegmentation/*.xml</config-location>
  </config-locations>
</module>
